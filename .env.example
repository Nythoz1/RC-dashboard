# Copy to .env and fill in. Without these, the app runs on localStorage only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_AI_FUNCTION_URL=https://your-project-ref.functions.supabase.co/ai

# Optional: Morning Brief function URL (derived from VITE_SUPABASE_URL when unset)
# VITE_BRIEF_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1/brief
